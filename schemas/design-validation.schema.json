{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esp-autodev.local/schemas/design-validation-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "valid", "errors", "warnings", "design_digest"],
  "properties": {"schema_version": {"const": "1.0"}, "project_id": {"type": "string"}, "valid": {"type": "boolean"}, "errors": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}, "design_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
