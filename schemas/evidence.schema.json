{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esp-autodev.local/schemas/evidence-1.0.json",
  "type": "object",
  "required": ["schema_version", "evidence_id", "run_id", "design_digest", "requirement_ids", "test_id", "owner", "tier", "expected", "actual", "verdict", "receipt_ids", "artifacts", "created_at"],
  "properties": {"schema_version": {"const": "1.0"}, "project_id": {"type": ["string", "null"]}, "evidence_id": {"type": "string"}, "run_id": {"type": "string"}, "design_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "requirement_ids": {"type": "array", "minItems": 1}, "test_id": {"type": "string"}, "owner": {"type": "string"}, "tier": {"enum": ["A", "B", "C"]}, "expected": {"type": "object"}, "actual": {"type": "object"}, "verdict": {"enum": ["PASS", "PASS_PENDING_TIER_C", "REPAIR", "FAIL", "BLOCKED"]}, "receipt_ids": {"type": "array", "minItems": 1}, "evidence_kinds": {"type": "array", "items": {"type": "string"}}, "artifacts": {"type": "array"}, "created_at": {"type": "string"}},
  "additionalProperties": true
}
