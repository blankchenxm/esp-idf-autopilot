{
  "registry_schema_version": "1.0",
  "rules": [
    {
      "rule_id": "HR-001-EVENT-DRIVEN-SUPERVISION",
      "statement": "Unchanged deterministic progress never wakes a model.",
      "applicable_schema_versions": {"1.0":"audit","1.1":"audit","1.2":"audit","1.3":"audit","1.4":"audit","1.5":"audit","1.6":"audit","1.7":"required"},
      "authority_inputs": ["checkpoint", "control-event-sequence"],
      "producer_node": "control_event_delivery",
      "validator": "validate_control_event_delivery",
      "required_receipt_kinds": ["control_event_report"],
      "failure_disposition": "INTERNAL_FAULT",
      "negative_test_ids": ["SCN-011-PROGRESS-NO-MODEL-WAKE"],
      "downstream_gates": ["terminal"]
    },
    {
      "rule_id": "HR-002-MODEL-CONTEXT-ENVELOPE",
      "statement": "Every Harness-owned model call consumes one bounded digest-bound context envelope.",
      "applicable_schema_versions": {"1.0":"audit","1.1":"audit","1.2":"audit","1.3":"audit","1.4":"audit","1.5":"audit","1.6":"audit","1.7":"required"},
      "authority_inputs": ["approved-design-digest", "checkpoint", "receipt-index"],
      "producer_node": "model_context",
      "validator": "validate_model_context",
      "required_receipt_kinds": ["model_transaction"],
      "failure_disposition": "INTERNAL_FAULT",
      "negative_test_ids": ["SCN-012-OWNER-CONTEXT-ISOLATION"],
      "downstream_gates": ["implementation_materialize"]
    },
    {
      "rule_id": "HR-003-CURRENT-SCHEMA",
      "statement": "Release-authoritative execution uses the current schema and all required capabilities.",
      "applicable_schema_versions": {"1.0":"blocked","1.1":"blocked","1.2":"blocked","1.3":"blocked","1.4":"blocked","1.5":"blocked","1.6":"blocked","1.7":"required"},
      "authority_inputs": ["approved-design"],
      "producer_node": "schema_gate",
      "validator": "require_executable_schema",
      "required_receipt_kinds": ["schema_gate"],
      "failure_disposition": "INTERNAL_FAULT",
      "negative_test_ids": ["SCN-016-LEGACY-SCHEMA-MIGRATION"],
      "downstream_gates": ["operation_authority","implementation_materialize","flash","closure","release_prepare"]
    },
    {
      "rule_id": "HR-004-OPERATION-AUTHORITY",
      "statement": "Every operation has exactly one typed admissible authority path.",
      "applicable_schema_versions": {"1.0":"blocked","1.1":"blocked","1.2":"blocked","1.3":"blocked","1.4":"blocked","1.5":"blocked","1.6":"blocked","1.7":"required"},
      "authority_inputs": ["operations","provider-receipts","implementation-facts"],
      "producer_node": "operation_authority",
      "validator": "compile_operation_authority",
      "required_receipt_kinds": ["operation_authority"],
      "failure_disposition": "INTERNAL_FAULT",
      "negative_test_ids": ["SCN-001-MISSING-TRANSPORT-AUTHORITY","SCN-002-UNSUPPORTED-OPERATION"],
      "downstream_gates": ["implementation_materialize","configure","build","flash","closure"]
    },
    {
      "rule_id": "HR-005-IMPLEMENTATION-COMPLETE",
      "statement": "Required operations are linked, reachable, non-stub and runtime-probed.",
      "applicable_schema_versions": {"1.0":"blocked","1.1":"blocked","1.2":"blocked","1.3":"blocked","1.4":"blocked","1.5":"blocked","1.6":"blocked","1.7":"required"},
      "authority_inputs": ["operations","source-manifest","build-link-map"],
      "producer_node": "implementation_completeness",
      "validator": "validate_implementation_completeness",
      "required_receipt_kinds": ["source_validation"],
      "failure_disposition": "REPAIR_INTERNAL",
      "negative_test_ids": ["SCN-002-UNSUPPORTED-OPERATION"],
      "downstream_gates": ["configure","build","flash","production_composition","closure"]
    },
    {
      "rule_id": "HR-006-PRODUCTION-COMPOSITION",
      "statement": "The selftest-off entrypoint reaches declared production operations and observation points.",
      "applicable_schema_versions": {"1.0":"blocked","1.1":"blocked","1.2":"blocked","1.3":"blocked","1.4":"blocked","1.5":"blocked","1.6":"blocked","1.7":"required"},
      "authority_inputs": ["runtime_flow","operations","production-scenarios"],
      "producer_node": "integration_evaluate",
      "validator": "validate_production_composition",
      "required_receipt_kinds": ["production_composition","evaluation"],
      "failure_disposition": "REPAIR_INTERNAL",
      "negative_test_ids": ["SCN-003-EMPTY-ORCHESTRATOR","SCN-004-INTEGRATION-BYPASS"],
      "downstream_gates": ["tier_c_artifact_materialization","closure","release_prepare"]
    },
    {
      "rule_id": "HR-007-TIER-C-PRODUCER",
      "statement": "Every nonphysical Tier C artifact has a receipt-bound producer and correlation chain.",
      "applicable_schema_versions": {"1.0":"blocked","1.1":"blocked","1.2":"blocked","1.3":"blocked","1.4":"blocked","1.5":"blocked","1.6":"blocked","1.7":"required"},
      "authority_inputs": ["tier_c","integration-receipts","firmware-hash"],
      "producer_node": "tier_c_artifact_materialization",
      "validator": "validate_tier_c_producer_chain",
      "required_receipt_kinds": ["tier_c_producer","tier_c_artifact"],
      "failure_disposition": "INTERNAL_FAULT",
      "negative_test_ids": ["SCN-005-TIER-C-NO-PRODUCER"],
      "downstream_gates": ["tier_c","closure"]
    },
    {
      "rule_id": "HR-008-IMAGE-BATCHING",
      "statement": "Compatible verification rows share an exact normalized image identity.",
      "applicable_schema_versions": {"1.0":"audit","1.1":"audit","1.2":"audit","1.3":"audit","1.4":"audit","1.5":"audit","1.6":"audit","1.7":"required"},
      "authority_inputs": ["verification","subsystems","source-digest"],
      "producer_node": "verification_batches",
      "validator": "normalize_verification_images",
      "required_receipt_kinds": ["verification_plan"],
      "failure_disposition": "INTERNAL_FAULT",
      "negative_test_ids": ["SCN-006-COMPATIBLE-BATCH","SCN-007-INCOMPATIBLE-IMAGE"],
      "downstream_gates": ["configure","build","flash","closure"]
    },
    {
      "rule_id": "HR-009-TYPED-RECOVERY",
      "statement": "Recovery is typed, lineage-bounded and admits at most one model repair per material revision.",
      "applicable_schema_versions": {"1.0":"audit","1.1":"audit","1.2":"audit","1.3":"audit","1.4":"audit","1.5":"audit","1.6":"audit","1.7":"required"},
      "authority_inputs": ["typed-diagnostic","failure-lineage","material-revision"],
      "producer_node": "recover",
      "validator": "validate_recovery_admission",
      "activation": "on_typed_failure",
      "required_receipt_kinds": ["failure","recovery"],
      "failure_disposition": "INTERNAL_FAULT",
      "negative_test_ids": ["SCN-013-UNTYPED-ADAPTER","SCN-014-LINEAGE-BUDGET"],
      "downstream_gates": ["implementation_materialize"]
    },
    {
      "rule_id": "HR-010-COMPONENT-ARCHITECTURE",
      "statement": "Resolved component/API dependencies match declared semantic ownership.",
      "applicable_schema_versions": {"1.0":"blocked","1.1":"blocked","1.2":"blocked","1.3":"blocked","1.4":"blocked","1.5":"blocked","1.6":"blocked","1.7":"required"},
      "authority_inputs": ["component_api_manifest","cmake-dependency-graph","source-manifest"],
      "producer_node": "component_architecture",
      "validator": "validate_component_architecture",
      "required_receipt_kinds": ["component_architecture"],
      "failure_disposition": "REPAIR_INTERNAL",
      "negative_test_ids": ["SCN-019-LOWLEVEL-IN-MAIN"],
      "downstream_gates": ["production_composition","closure","release_prepare"]
    },
    {
      "rule_id": "HR-011-CLEAN-RELEASE",
      "statement": "Release is fullclean, selftest-off, behavior-bearing and forbidden-state aware.",
      "applicable_schema_versions": {"1.0":"blocked","1.1":"blocked","1.2":"blocked","1.3":"blocked","1.4":"blocked","1.5":"blocked","1.6":"blocked","1.7":"required"},
      "authority_inputs": ["closure","release","production-scenarios","hardware-identity"],
      "producer_node": "release_validate",
      "validator": "validate_release_transaction",
      "required_receipt_kinds": ["release_fullclean","release_configure","release_build","release_flash","release_observe","release_production_scenario"],
      "failure_disposition": "INTERNAL_FAULT",
      "negative_test_ids": ["SCN-017-READY-ONLY-RELEASE","SCN-018-RELEASE-NO-FULLCLEAN"],
      "downstream_gates": ["terminal"]
    },
    {
      "rule_id": "HR-012-WORKER-LIVENESS",
      "statement": "Status reconciles worker, job, checkpoint and projection state.",
      "applicable_schema_versions": {"1.0":"audit","1.1":"audit","1.2":"audit","1.3":"audit","1.4":"audit","1.5":"audit","1.6":"audit","1.7":"required"},
      "authority_inputs": ["active-job","worker-pid","checkpoint","projection"],
      "producer_node": "status_reconcile",
      "validator": "reconcile_worker_state",
      "required_receipt_kinds": ["worker_reconciliation"],
      "failure_disposition": "INTERNAL_FAULT",
      "negative_test_ids": ["SCN-008-DEAD-WORKER"],
      "downstream_gates": ["resume"]
    },
    {
      "rule_id": "HR-013-SIDE-EFFECT-TRANSACTIONS",
      "statement": "Each external side-effect class has its own resumable idempotent checkpoint.",
      "applicable_schema_versions": {"1.0":"blocked","1.1":"blocked","1.2":"blocked","1.3":"blocked","1.4":"blocked","1.5":"blocked","1.6":"blocked","1.7":"required"},
      "authority_inputs": ["transaction-plan","idempotency-key","artifact-index"],
      "producer_node": "invariant_gate",
      "validator": "validate_transaction_topology",
      "required_receipt_kinds": ["graph_conformance","configure","build","flash","observation","evaluation","evidence_commit"],
      "failure_disposition": "INTERNAL_FAULT",
      "negative_test_ids": ["SCN-015-TRANSACTION-CRASH-MATRIX"],
      "downstream_gates": ["configure","build","flash","observe","evidence_commit","closure","release_prepare"]
    },
    {
      "rule_id": "HR-014-PROJECT-HYGIENE",
      "statement": "Generated verification roots are ignored, retention-bounded and never staged.",
      "applicable_schema_versions": {"1.0":"audit","1.1":"audit","1.2":"audit","1.3":"audit","1.4":"audit","1.5":"audit","1.6":"audit","1.7":"required"},
      "authority_inputs": ["project-runtime-policy","git-ignore"],
      "producer_node": "initialize",
      "validator": "validate_generated_file_hygiene",
      "required_receipt_kinds": ["project_hygiene"],
      "failure_disposition": "INTERNAL_FAULT",
      "negative_test_ids": ["SCN-021-PROJECT-HYGIENE"],
      "downstream_gates": ["configure","closure"]
    }
  ]
}
